NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY: aún NO la usa ningún código (todo pasa por el service client).
# Necesaria hasta la Fase 2+ (PWA de cajero / cliente de navegador). Puede ir en blanco por ahora.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ SECRETOS DE SERVIDOR — nunca los expongas al navegador (no llevan prefijo NEXT_PUBLIC_
# a propósito), nunca los commitees, y nunca los compartas fuera de .env.local / variables
# de entorno de Vercel. La service_role key da acceso TOTAL a la base de datos; las llaves
# de Apple firman los passes y los push de FM.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_BASE_URL=

# Apple Wallet (Tarea 6 del plan: developer.apple.com → Pass Type ID + certificados + APNs key)
# Los _B64 son los archivos .pem/.p8 codificados con: base64 -w0 <archivo>
APPLE_TEAM_ID=
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_SIGNER_CERT_B64=
APPLE_SIGNER_KEY_B64=
APPLE_WWDR_B64=
APNS_KEY_B64=
APNS_KEY_ID=

# Meta (píxel y API de conversiones). Ver lib/marketing/.
# El ID del conjunto de datos NO es secreto (va al navegador). Next lo escribe al COMPILAR:
# cambiarlo en Vercel pide redeploy. Sin él, no hay píxel ni Subscribe.
NEXT_PUBLIC_META_PIXEL_ID=
# Número de WhatsApp de Cardly en formato internacional (50370001234). Sin él, el ícono del pie
# queda decorativo y no hay evento Contact.
NEXT_PUBLIC_WHATSAPP_CARDLY=
# ⚠️ SECRETO DE SERVIDOR: token de la API de conversiones (Administrador de eventos → Configuración →
# API de conversiones → Generar token). Sin él, Subscribe no se envía.
META_CAPI_TOKEN=
# Opcional, SOLO para validar: el código de "Probar eventos". Con él Subscribe no cuenta para
# anuncios. Borralo al terminar.
META_CAPI_TEST_EVENT_CODE=

# Wompi (pasarela de pagos). Ver docs/superpowers/specs/2026-09-21-pasarela-wompi-design.md.
# ⚠️ SECRETOS DE SERVIDOR: el App ID y el API Secret del panel de Wompi (Aplicativos → tu aplicativo).
# El API Secret firma el webhook (header wompi_hash): quien lo tiene puede falsificar un pago.
# Van en .env.local y en las variables de entorno de Vercel, NUNCA en el chat ni en el repo.
WOMPI_CLIENT_ID=
WOMPI_CLIENT_SECRET=
# SOLO en desarrollo local: con 1, un pago de PRUEBA de Wompi sí aplica el plan. Se ignora en Vercel
# (Preview y Production comparten la base real): no lo pongas allá.
WOMPI_ACEPTAR_PRUEBAS=
# Opcionales: las URLs por defecto son https://api.wompi.sv y https://id.wompi.sv.
WOMPI_API_URL=
WOMPI_ID_URL=
